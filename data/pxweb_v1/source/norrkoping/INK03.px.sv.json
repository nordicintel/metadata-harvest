              "label": {
                "0": "20 år och äldre",
                "1": "20-64/65 år"
              },
              "note": {
                "1": [
                  "Till och med år 2022 redovisas åldersgruppen 20-64 år, som betraktas som de yrkesaktiva åldrarna. Fr o m 2023 redovisas åldersgruppen 20-65 år eftersom åldern för garantipentions då höjdes från 65 till 66 år, därmed betraktas 20-65 år som yrkesaktiva åldrar."
                ]
              }
            },
