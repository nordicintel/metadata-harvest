            }
          },
          "Orsak till inställt möte": {
            "label": "Cause of cancelled hearing",
            "category": {
              "label": {
                "Lack of notification service to another party": "Lack of notification service to another party",
                "New indictment, evidence, circumstances": "New indictment, evidence, circumstances",
                "Absence of counsel or prosecutor": "Absence of counsel or prosecutor",
                "Valid absence of party": "Valid absence of party",
                "Invalid absence of party": "Invalid absence of party",
                "Interpreter shortage": "Interpreter shortage",
                "Valid absence of another party": "Valid absence of another party",
                "Invalid absence of another party": "Invalid absence of another party"
              },
              "note": {
                "Lack of notification service to another party": [
                  "The hearing is cancelled because another party (e.g.witness, injured party to be heard, guardian) has not been served with a notice of the hearing and the hearing is deemed unable to take place. Even hearings that have already started, where the court finds that an obstacle exists (due to lack of notification service), are recorded as cancelled."
                ],
                "New indictment, evidence, circumstances": [
                  "The hearing is cancelled due to new circumstances that have arisen and require further preparation. Also applicable in cases  when there is a need to order a personal investigation."
                ],
                "Absence of counsel or prosecutor": [
                  "The hearing is cancelled due to a counsel, prosecutor, or equivalent having reported a valid impediment before the hearing, or alternatively, not attending the hearing. Also in cases of conflict of interest."
                ],
                "Valid absence of party": [
                  "The hearing is cancelled because a party that was served notice of the hearing has reported a valid impediment before the hearing."
                ],
                "Invalid absence of party": [
                  "The hearing is cancelled because the party who was served notice of the meeting does not attend the hearing without notifying a valid reason for their absence."
                ],
                "Interpreter shortage": [
                  "The hearing is cancelled due to a shortage of interpreters. It has not been possible to book an interpreter, the booked interpreter does not show up or the need for an interpreter is identified during the ongoing hearing."
                ],
                "Valid absence of another party": [
                  "The hearing is cancelled because another party (e.g. witness, injured party to be heard, guardian) who was served a summons to the hearing has reported a valid impediment before the hearing."
                ],
                "Invalid absence of another party": [
                  "The hearing is cancelled due to another party (e.g. witness, injured party to be heard, guardian), who has been summoned to the hearing, not attending without notifying a valid reason for their absence."
                ]
              }
            },
            "extension": {
              "elimination": false,
              "show": "value"
            }
