[
  {
    "seriesId": "SECBREPOEFF",
    "source": "Sveriges Riksbank",
    "shortDescription": "Policy rate",
    "midDescription": "Policy rate",
    "longDescription": "The policy rate is the interest rate at which the banks can borrow or deposit in the Riksbank over a 7-day period. The policy rate is the Riksbank's most important key rate.\nThe policy rate was called The repo rate until June 8, 2022. ",
    "groupId": 2,
    "observationMaxDate": "2026-10-16",
    "observationMinDate": "1994-06-01",
    "seriesClosed": false
  },
  {
    "seriesId": "SECBDEPOEFF",
    "source": "Sveriges Riksbank",
    "shortDescription": "Deposit rate",
    "midDescription": "Deposit rate",
    "longDescription": "The deposit rate is the rate of interest banks receive when they deposit funds in their accounts at the Riksbank overnight and is always 0.75 percentage points lower than the policy rate. The deposit rate is the floor of what is known as the interest rate corridor and is one of the Riksbank's three key rates.",
    "groupId": 2,
    "observationMaxDate": "2026-10-16",
    "observationMinDate": "1994-06-01",
    "seriesClosed": false
  },
  {
    "seriesId": "SECBLENDEFF",
    "source": "Sveriges Riksbank",
    "shortDescription": "Lending rate",
    "midDescription": "Lending rate",
    "longDescription": "The lending rate is the rate of interest banks pay when they borrow overnight funds from the Riksbank and is always 0.75 percentage points higher than the policy rate. The lending rate is known as the ceiling of the interest rate corridor and is one of the Riksbank's three key rates.",
    "groupId": 2,
    "observationMaxDate": "2026-10-16",
    "observationMinDate": "1994-06-01",
    "seriesClosed": false
  },
  {
    "seriesId": "SECBLIKVEFF",
    "source": "Sveriges Riksbank",
    "shortDescription": "Liquidity facility rate",
    "midDescription": "Liquidity facility rate",
    "longDescription": "The liquidity facility rate is the interest rate for the lending that the Riksbank offers to the banks in the supplementary liquidity facility. This interest rate is currently 0.75 percentage points higher than the policy rate",
    "groupId": 2,
    "observationMaxDate": "2026-10-16",
    "observationMinDate": "2022-06-08",
    "seriesClosed": false
  },
  {
    "seriesId": "SECBMARGEFF",
    "source": "Sveriges Riksbank",
    "shortDescription": "Marginal rate",
    "midDescription": "Marginal rate",
    "longDescription": "The marginal rate was the Riksbank's key rate from December 1985 until the end of May 1994. The marginal rate was the rate at which banks could marginally borrow from or deposit in the Riksbank in the interest rate ladder.",
    "groupId": 2,
    "observationMaxDate": "1994-05-31",
    "observationMinDate": "1987-01-30",
    "seriesClosed": true
  },
  {
    "seriesId": "SECBREFEFF",
    "source": "Sveriges Riksbank",
    "shortDescription": "Reference rate",
    "midDescription": "Reference rate",
    "longDescription": "The reference rate is set by the Riksbank half-yearly and corresponds to the Riksbank's policy rate at the end of the previous half year, rounded up if necessary to the nearest half per cent. The Riksbank’s reference rate has no monetary policy purpose, but can be used to calculate other interest rates such as interest on overdue payments, for example. The Riksbank’s reference rate has existed since 1 July 2002, when it replaced what was then known as the discount rate.",
    "groupId": 3,
    "observationMaxDate": "2026-10-16",
    "observationMinDate": "2002-07-01",
    "seriesClosed": false
  },
  {
    "seriesId": "SECBDISCEFF",
    "source": "Sveriges Riksbank",
    "shortDescription": "Discount rate",
    "midDescription": "Discount rate",
    "longDescription": "The discount rate was a reference rate based on market interest rates and always followed general interest rates. It was based on the average of 6-monthly and 5-yearly rates (fixing) over the past quarter with a haircut of 2.5 percentage points.",
    "groupId": 3,
    "observationMaxDate": "2002-06-28",
    "observationMinDate": "1907-11-11",
    "seriesClosed": true
  },
