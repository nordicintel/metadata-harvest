        },
        "label": {
          "Work load and/or shortage of courtrooms": "Arbetsanhopning och/eller salsbrist",
          "Lack of notification service to party": "Bristande delgivning Part",
          "Lack of notification service to another party": "Bristande delgivning Övrig aktör",
          "New indictment, evidence, circumstances": "Ny stämning/bevisning/sakomständighet/ utredning etc.",
          "Absence of counsel or prosecutor": "Ombuds, biträdes eller åklagares frånvaro",
          "Valid absence of party": "Parts giltiga frånvaro",
          "Invalid absence of party": "Parts ogiltiga frånvaro",
          "Interpreter shortage": "Tolkbrist",
          "Valid absence of another party": "Övrig aktörs giltiga frånvaro",
          "Invalid absence of another party": "Övrig aktörs ogiltiga frånvaro"
        },
        "note": {
          "Work load and/or shortage of courtrooms": [
            "Mötet ställs in p.g.a. arbetsanhopning (t. ex domarbrist), brist på salar i domstolen/nämnden (även teknikproblem), domare/nämndemans frånvaro (t.ex. jäv) och/eller samordning av mål."
          ],
          "Lack of notification service to party": [
            "Mötet ställs in p.g.a. att part inte är delgiven kallelse till mötet och mötet bedöms inte kunna genomföras. Även påbörjade möten där rätten konstaterar att hinder föreligger (p.g.a. bristande delgivning) registreras som inställda p.g.a. bristande delgivning."
          ],
          "Lack of notification service to another party": [
            "Mötet ställs in p.g.a. att Övrig aktör (t.ex. vittne, målsägande att höras, vårdnadshavare) inte är delgiven kallelse till mötet och mötet bedöms inte kunna genomföras. Även påbörjade möten där rätten konstaterar att hinder föreligger (p.g.a. bristande delgivning) registreras som inställda p.g.a. bristande delgivning."
          ],
          "New indictment, evidence, circumstances": [
            "Mötet ställs in p.g.a. nya omständigheter som kommit in och som kräver ytterligare beredning. Även vid ej skäligt rådrum och vid behov av att förordna om personutredning."
          ],
          "Absence of counsel or prosecutor": [
            "Mötet ställs in p.g.a. att ombud, biträde, åklagare eller motsvarande anmält giltigt förhinder innan mötet, alternativt inte kommer till mötet. Även jävsituation."
          ],
          "Valid absence of party": [
            "Mötet ställs in p.g.a. att part som delgivits kallelse till mötet anmält giltigt förhinder innan mötet."
          ],
          "Invalid absence of party": [
            "Mötet ställs in p.g.a. att part som delgivits kallelse till mötet inte kommer till mötet utan att anmäla giltigt förhinder."
          ],
          "Interpreter shortage": [
            "Mötet ställs in p.g.a. tolkbrist. Det har inte varit möjligt att boka tolk/Bokad tolk infinner sig inte/Tolkbehov identifierat under pågående möte."
          ],
          "Valid absence of another party": [
            "Mötet ställs in p.g.a. att övrig aktör (t.ex. vittne, målsägande att höras, vårdnadshavare) som delgivits kallelse till mötet anmält giltigt förhinder innan mötet."
          ],
          "Invalid absence of another party": [
            "Mötet ställs in p.g.a. att övrig aktör (t.ex. vittne, målsägande att höras, vårdnadshavare) som delgivits kallelse till mötet inte kommer till mötet utan att anmäla giltigt förhinder."
          ]
        }
      },
