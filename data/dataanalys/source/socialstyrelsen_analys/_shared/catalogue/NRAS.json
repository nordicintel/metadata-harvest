        "query": "WITH with_permalink AS (\n  SELECT\n  *,\n  CASE\n    WHEN 'dataanalys.socialstyrelsen.se' LIKE '%superset-at%'\n      OR 'dataanalys.socialstyrelsen.se' LIKE '%nixapa17v%' THEN PermalinkDashboardTest\n    ELSE PermalinkDashboardProd\n  END AS permalink\n  FROM [semantic].[VAI_NRAS_GroupStats_LastObs]\n),\n__cte AS (\nSELECT\n\t  MBusinessKey\n\t  ,MName\n      ,InputType\n      ,AreaName\n\t    ,[semantic].[HrefIndicatorDashboard](\n        'dataanalys.socialstyrelsen.se',\n        URLslugDashboardTitle, \n        Unit, \n        permalink\n        ) as HrefIndicatorDashboard \n      ,[semantic].[LinkAreaDashboard]('dataanalys.socialstyrelsen.se', URLslugStartpageDashboard) as LinkStartPageDashboard\n      ,LinkStartPageDashboardTitle\n      ,Unit\n\t  ,LinkIndicatorDescription\n\t  ,LinkIndicatorDescriptionTitle\n\t  ,LinkAreaDescription\n\t  ,LinkAreaDescriptionTitle\n\t  ,mattenhet_kort\n      ,Description\n      ,Aim\n      ,DesiredValue\n      ,DataSource\n      ,[Keywords]\n      ,NumeratorDefinition\n      ,DenominatorDefinition\n\t  ,[MeasurementPeriodType]\n      ,[FirstYear]\n      ,[LastYear]\n      ,LastPeriod\n\t  ,MeasurePeriodInterval\n      ,LastValue\n      ,FirstValue\n      ,UnitChangeFirstValue\n\t  ,UnitChangePreviousValue\n\t  ,GrowthFirstValue\n\t  ,GrowthPreviousValue\n      ,[DataGenerationDate]\n  FROM with_permalink\n)\nSELECT TOP 1000 [MBusinessKey] AS [MBusinessKey], [HrefIndicatorDashboard] AS [HrefIndicatorDashboard], [DataGenerationDate] AS [DataGenerationDate], [MName] AS [MName], [Unit] AS [Unit], [AreaName] AS [AreaName], [LinkIndicatorDescription] AS [LinkIndicatorDescription], [LinkIndicatorDescriptionTitle] AS [LinkIndicatorDescriptionTitle], [DataSource] AS [DataSource], [Description] AS [Description], [DesiredValue] AS [DesiredValue], [InputType] AS [InputType], [Keywords] AS [Keywords], [MeasurePeriodInterval] AS [MeasurePeriodInterval] \nFROM __cte GROUP BY [MBusinessKey], [HrefIndicatorDashboard], [DataGenerationDate], [MName], [Unit], [AreaName], [LinkIndicatorDescription], [LinkIndicatorDescriptionTitle], [DataSource], [Description], [DesiredValue], [InputType], [Keywords], [MeasurePeriodInterval];\n\n",
