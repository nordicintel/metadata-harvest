          "is_cached": null,
          "query": "SELECT TOP 20000 [GroupTypeName] AS [GroupTypeName], [GroupName] AS [GroupName], [Gender] AS [Gender], [Age] AS [Age], [Measurementperiodtype] AS [Measurementperiodtype], [MeasurementPeriod] AS [MeasurementPeriod], [MeasurementPeriodDate] AS [MeasurementPeriodDate] \nFROM (SELECT \n\t  MBusinessKey\n    ,Version\n\t  ,GroupKey\n\t  ,MTypeBusinessKey\n    ,MTypeName\n\t  ,MName\n    ,GroupTypeName\n    ,Indelning_typ_desc\n\t  ,Enhet\n\t  ,Kommun\n\t  ,Region\n    ,GroupName\n    ,MeasurementPeriod\n\t  ,Measurementperiodtype\n\t  ,MeasurementPeriodDate\n\t  ,PeriodStartYear\n\t  ,PeriodStartQuarter\n\t  ,IsLastPeriod\n\t  ,LastPeriodFilterFlag\n    ,Age\n    ,Gender\n\t  ,concat(GroupName, '; ', Age, '; ', Gender) as LegendBase\n  \t,ValueD0\n\t  ,ValueD1\n\t  ,Value\n    ,ValueD3\n    ,ValueD4\n    ,ValueChar\n    ,Numerator\n\t  ,Denominator\n\t  ,CIhigh\n\t  ,CIlow\n\t  ,Crude\n\t  ,CrudeCILow\n\t  ,CrudeCIHigh\n    ,Commentary\n    ,DataGenerationDate\n    ,case when age in ('18 år eller äldre', '17 år eller yngre') then [Value] else Crude end as Value_Crude\n\tFROM [semantic].[VAI_OB_Trends]\n) AS virtual_table \nWHERE [MBusinessKey] IN (N'OB245') AND [GroupTypeName] IN (N'Riket', N'Region') GROUP BY [GroupTypeName], [GroupName], [Gender], [Age], [Measurementperiodtype], [MeasurementPeriod], [MeasurementPeriodDate];\n\n",
