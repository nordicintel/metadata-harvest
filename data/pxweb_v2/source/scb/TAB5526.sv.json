            },
            "label": {
              "0650": "föredrar att shoppa personligen/vill se produkten i verkligheten",
              "0655": "saknad kunskap för hur man beställer via internet",
              "0670": "leveransen av varor eller tjänster är ett problem",
              "0675": "oro kring betalning via internet eller den personliga integriteten",
              "0680": "oro inför leverans eller retur av vara/tjänst",
              "0685": "har inte något kredit- eller betalkort som man kan betala med via internet",
              "0690": "återförsäljare i utlandet inte säljer eller levererar till Sverige",
              "0695": "någon annan person beställde/köpte varor/tjänster åt dig ",
              "0699": "andra orsaker"
            },
            "note": {
              "0650": [
                "T.ex. av lojalitetsskäl till butiker eller av gammal vana."
              ],
              "0655": [
                "T.ex. var för komplicerat."
              ],
              "0670": [
                "T.ex. att det tar för lång tid eller finns problem med logistiken."
              ],
              "0675": [
                "T.ex. att lämna ut kreditkortsuppgifter eller annat personligt innehåll via internet."
              ],
              "0680": [
                "Även klagomålshantering."
              ]
            }
          },
