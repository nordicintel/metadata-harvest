        "Typflyttning": {
          "label": "domestic migration by type",
          "category": {
            "index": {
              "InomFast": 0,
              "MFastiDist": 1,
              "MDistiKommun": 2,
              "MKommuniL": 3,
              "ÖLandG": 4
            },
            "label": {
              "InomFast": "Within real estate",
              "MFastiDist": "Between real estates in the district",
              "MDistiKommun": "Between districts within the municipality",
              "MKommuniL": "Between municipalities within the county",
              "ÖLandG": "Over the county border"
            },
            "note": {
              "MFastiDist": [
                "Between the years 2000 - 2015 was the districts related to parishes. It causes a sharp break in series between 2015 and 2016 for the characteristics ´Between real estates in the district´ and ´Between districts within the municipality´. The reason is that the number of parishes in 2015 was 1,472 and the number of districts in 2016 was 2,523. This leads to fewer domestic migrations are made within districts and more migrations across the district border in 2016 and later than the years before.",
                "On 1 January 2000 Church of Sweden was separated from the state. This has led to a gradually decline in the number of parishes from more than 2,500 parishes in 2000 to nearly 1,400 parishes in 2015. This affects comparability between years."
              ],
              "MDistiKommun": [
                "Between the years 2000 - 2015 was the districts related to parishes. It causes a sharp break in series between 2015 and 2016 for the characteristics ´Between real estates in the district´ and ´Between districts within the municipality´. The reason is that the number of parishes in 2015 was 1,472 and the number of districts in 2016 was 2,523. This leads to fewer domestic migrations are made within districts and more migrations across the district border in 2016 and later than the years before.",
                "On 1 January 2000 Church of Sweden was separated from the state. This has led to a gradually decline in the number of parishes from more than 2,500 parishes in 2000 to nearly 1,400 parishes in 2015. This affects comparability between years."
              ]
            }
          },
