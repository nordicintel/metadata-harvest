            "label": {
              "0650": "föredrar att shoppa personligen/vill se produkten i verkligheten",
              "1029": "upplevde svårigheter med att göra beställningar online",
              "1031": "var orolig över leveranskostnader för varor",
              "1033": "var orolig för att leveransen inte skulle komma fram hel eller i tid",
              "1035": "var orolig kring betalningssäkerhet eller den personliga integriteten",
              "1037": "var orolig över returer, klagomål/återbetalning",
              "1039": "det fanns inget behov att handla online de senaste tre månaderna",
              "1041": "annan orsak"
            },
            "note": {
              "0650": [
                "T.ex. av lojalitetsskäl till butiker eller av gammal vana."
              ],
              "1029": [
                "T.ex. var för komplicerat."
              ]
