      "class": "dataset",
      "label": "Fastighetsprisindex för fritidshus (1981=100) efter region. År 1975-2025",
      "source": "SCB",
      "updated": "2026-06-05T06:00:00Z",
      "link": {
        "related": [
          {
            "extension": {
              "relation": "statistics-homepage",
              "metaid": "PRODUCTCODE:BO0501"
