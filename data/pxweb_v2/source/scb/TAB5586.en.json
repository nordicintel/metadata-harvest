              "OHM": "Other soil sealed land",
              "TOTHM": "Total impervious land",
              "TOTLA": "Total land area"
            },
            "note": {
              "BYGG": [
                "Land under buildings according to the Cadastral map. Surfaces under buildings are automatically classified as impervious."
              ],
              "VJ": [
                "Land under roads and railways according to the National Road Database and the National Railway Database. Surfaces under roads and railways are automatically classified as impervious."
              ],
              "OHM": [
                "Land which, according to interpretation of satellite images, is soil sealed but not under building or road and railway. Other soil sealed land includes paved surfaces or other artificially impermeable land. For methodological reasons, other soil sealed land includes also naturally hard and/or non-vegetated surfaces such as bare rocks, sand dunes and beaches."
              ],
              "TOTHM": [
                "Sum of all artificial land without vegetation including building roofs, parking lots, streets and roads, railways, walkways etc."
              ],
              "TOTLA": [
                "Total land area within the urban boundary."
              ]
            }
