      "class": "dataset",
      "label": "Institutioner och barn inom barnomsorg efter skolform och kön. År 1937-2023",
      "source": "SCB",
      "updated": "2024-04-24T06:00:00Z",
      "link": {
        "related": [
          {
            "extension": {
              "relation": "statistics-homepage",
              "metaid": "PRODUCTCODE:UF0550"
