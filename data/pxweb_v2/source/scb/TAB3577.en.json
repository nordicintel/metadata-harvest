            "note": {
              "B1g": [
                "GDP (gross domestic product) at market price refers to the sector total economy (S1) and value added gross at basic price refers to the institutional subsectors (S11, S12, S13, S14+15, S1N). The sum of value added at gross basic price by all institutional subsectors thus results in GDP at market price for the total economy."
              ],
              "B1n": [
                "NDP (net domestic product) at market price refers to the sector total economy (S1) and value added net at basic price refers to the institutional subsectors (S11, S12, S13, S14+15, S1N). The sum of value added at net basic price by all institutional subsectors thus results in NDP at market price for the total economy."
              ]
            }
