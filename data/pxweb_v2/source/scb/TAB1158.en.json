            "note": {
              "BO0501G7": [
                "For the years 1994–1999 means the assessed value according to the general assessment of real estate in 1994. \r\n \nFor the years 2000–2006 means the assessed value according to the general assessment of real estate in 2000. \r\n \nFor the years 2007–2012 means the assessed value according to the general assessment of real estate in 2007. \r\n \nFor the years 2013–2018 means the assessed value according to the general assessment of real estate in 2013. \r\n \nFor the years 2019-2024 means the assessed value according to the general assessment of real estate in 2024. \r\n  \r\nFrom 2025 means the assessed value according to the general assessment of real estate in 2025."
              ],
              "BO0501G8": [
                "Purchase-price-coefficient = Purchase price divided by assessed value",
                "For the years 1994–1999 the purchase-price-coefficient is calculated as the purchase price according to the assessed value for 1994. \r\n \nFor the years 2000–2006 the purchase-price-coefficient is calculated as the purchase price according to the assessed value for 2000. \r\n \nFor the years 2007–2012 the purchase-price-coefficient is calculated as the purchase price according to the assessed value for 2007. \r\n \nFor the years 2013–2018 the purchase-price-coefficient is calculated as the purchase price according to the assessed value for 2013. \r\n \nFor the years 2019-2024 the purchase-price-coefficient is calculated as the purchase price according to the assessed value for 2019. \r\n  \r\nFrom 2025 the purchase-price-coefficient is calculated as the purchase price according to the assessed value for 2025."
              ]
