            "label": {
              "0420": "kredit- eller kontokortsbedrägerier",
              "0425": "förlorat dokument, bilder eller annan data",
              "0430": "missbruk av din personliga information som finns tillgänglig på internet ",
              "0435": "sociala nätverk eller e-post konto har blivit hackat, där innehållet lagts ut eller skickats utan ens vetskap",
              "0440": "identitetsstöld online",
              "0445": "tagit emot e-postmeddelanden från bedragare (Phishing)",
              "0450": "blivit omdirigerad till falska webbplatser som begärt personlig information (Pharming)",
              "0455": "upplevt ekonomisk förlust till följd av identitetsstöld, e-postmeddelanden från bedragare eller omdirigering till falska webbplatser"
            },
            "note": {
              "0425": [
                "Pga. virus eller annan datorinfektion, t.ex. en mask eller en trojan."
              ],
              "0430": [
                "Vilket resulterat i t.ex. diskriminering, trakasserier eller mobbing."
              ],
              "0440": [
                "T.ex. att någon stulit dina personuppgifter och utgett sig för att vara dig, shoppat under ditt namn."
              ]
            }
