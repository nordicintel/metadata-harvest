      "version": "2.0",
      "class": "dataset",
      "label": "Long term income by region, region of birth, type of household and age, equalised disposable income. Period (2011-2012)-(2023-2024)",
      "source": "Statistics Sweden",
      "updated": "2026-03-26T07:00:00Z",
      "link": {
        "related": [
          {
            "extension": {
              "relation": "statistics-homepage",
              "metaid": "PRODUCTCODE:HE0110"
