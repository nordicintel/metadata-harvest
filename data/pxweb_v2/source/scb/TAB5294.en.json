            "note": {
              "UTL": [
                "In 1997, the Information missing category was added. Information missing is included in the categories World excluding Europe and Rest of the world."
              ],
              "VRLDEXEUR": [
                "In 1997, the Information missing category was added. Information missing is included in the categories World excluding Europe and Rest of the world."
              ],
              "OVEUR": [
                "In 1978–1994, the Rest of Europe category comprised all European countries except for Denmark, Finland, France, Germany, Italy, the Netherlands, Norway, Sweden, Switzerland, the United Kingdom, which were reported separately. \r\n Subsequently, the following changes have been made: \r\n As from 1995, Austria, Belgium, Estonia, Latvia, Lithuania, Poland, Russia, and Spain are reported separately and therefore are no longer included in the Rest of Europe category. \r\n As from 1997, the Czech Republic, Greece, Hungary, Iceland, Ireland, Luxembourg, Portugal, Slovakia, and Turkey are reported separately and therefore are no longer included in the Rest of Europe category. \r\n As from 2008, Bulgaria, Cyprus, Malta, Romania, and Slovenia are reported separately and therefore are no longer included in the Rest of Europe category."
              ],
              "OVAM": [
                "In 1997, the Rest of the Americas category, which was previously included in the Other countries category, was added. Subsequently, the following change has been made: \r\n As from 2008, Brazil is reported separately and therefore is no longer included in the Rest of the Americas category."
              ],
              "OVASI": [
                "In 1997, the Other Asia category, which was previously included in the Other countries category, was added. Subsequently, the following changes have been made: \r\n As from 2004, China is reported separately and therefore is no longer included in the Other Asia category. \r\n As from 2008, India is reported separately and therefore is no longer included in the Other Asia category."
              ],
              "OVR": [
                "In 1978–1994, the Other countries category comprised all non-European countries except Canada, Japan, and the United States, which were reported separately. Subsequently, the following changes have been made: \r\n As from 1995, Australia and South Korea are reported separately and therefore are no longer included in the Other countries category. \r\n As from 1997, New Zealand is reported separately and therefore is no longer included in the Other countries category. \r\n In 1997, the Rest of the Americas and the Other Asia categories were added, and therefore are no longer included in the Other countries category."
              ],
              "ÖUS": [
                "In 1997, the Information missing category was added. Information missing is included in the categories World excluding Europe and Rest of the world."
              ]
            }
