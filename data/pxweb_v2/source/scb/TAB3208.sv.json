              "3": 2,
              "4": 3,
              "5": 4
            },
            "label": {
              "1": "lediga för uthyrning",
              "2": "under reparation",
              "3": "förestående rivning",
              "4": "annan orsak",
              "5": "totalt"
            },
            "note": {
              "1": [
                "Lediga för uthyrning avser lägenheter lediga för omedelbar uthyrning vid mättidpunkten \r\n (1 september eller 1 mars) undersökningsåret."
              ],
              "2": [
                "Under reparation avser lägenheter som är outhyrda pga reparation vid mättidpunkten \r\n (1 september eller 1 mars) undersökningsåret."
              ],
              "3": [
                "Förestående rivning avser lägenheter som är outhyrda pga förestående rivning vid mättidpunkten (1 september eller 1 mars) undersökningsåret."
              ],
              "4": [
                "Annan orsak avser lägenheter som är outhyrda pga andra orsaker, exempelvis lägenhet friställd som evakueringslägenhet eller under utredning. Avser mättidpunkten 1 september eller 1 mars undersökningsåret."
              ]
            }
