            },
            "label": {
              "GYTA": "Green space",
              "AM": "Arable land",
              "TOTEJHM": "Total non-impervious surface",
              "HMARK": "Impervious land",
              "OEJKM": "Other (unclassified) land",
              "VATTEN": "Water",
              "TOTLA": "Total land area"
            },
            "note": {
              "GYTA": [
                "All types of vegetated patches that make up the total greenery within the urban boundary regardless of ownership or accessibility. Green space encompasses public parks as well as private villa gardens and green spaces between roads etc. Green space can be either open land or forested land."
              ],
              "AM": [
                "Land used for, or potentially can be used for, crop production or grazing and is suitable for plowing. Arable land is derived from the Land Parcel Information System (LPIS) managed by the Swedish Board of Agriculture."
              ],
              "TOTEJHM": [
                "Any land within the urban boundary that is not soil sealed, ie green space and arable land."
              ],
              "HMARK": [
                "Artificial land without vegetation including building roofs, parking lots, streets and roads, railways, walkways etc. For methodological reasons, impervious surface includes also naturally hard and/or non-vegetated surfaces such as bare rocks, sand dunes and beaches. Impervious land can be further divided into subcategories buildings, roads and railways and other soil sealed land."
              ],
              "OEJKM": [
                "Consists of land that for various reasons could not be attributed to either impervious surface or non-impervious surface. The cause is usually due to disturbances in the satellite imagery, such as shadows from tall and closely spaced buildings."
              ],
              "VATTEN": [
                "Defined as an open body of water according to the Swedish cadastral map."
              ],
              "TOTLA": [
                "Total land area within the urban boundary."
              ]
            }
          },
