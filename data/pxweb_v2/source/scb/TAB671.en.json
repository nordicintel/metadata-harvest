      "class": "dataset",
      "label": "Number of Swedish and foreign ownership of buildings for seasonal and secondary use owned by private persons by region. Year 1998-2025",
      "source": "Statistics Sweden",
      "updated": "2026-03-27T07:00:00Z",
      "link": {
        "related": [
          {
            "extension": {
              "relation": "statistics-homepage",
              "metaid": "PRODUCTCODE:BO0104"
