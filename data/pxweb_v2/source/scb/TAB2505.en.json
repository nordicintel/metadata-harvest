          "label": "media habits",
          "category": {
            "index": {
              "K010": 0,
              "K020": 1,
              "K030": 2,
              "K040": 3,
              "K050": 4
            },
            "label": {
              "K010": "watch TV or films at least 3 hours per day, 2008–2014",
              "K020": "play computer games at least 3 hours per day, 2008–2014",
              "K030": "send e-mail, chat or surf the Internet at least 3 hours per day, 2008–2014",
              "K040": "send e-mail, chat or surf the Internet at least 1 hour per day, 2008–2014",
              "K050": "have been teased/bullied on internet during last six months, 2008–2012"
            },
            "note": {
              "K010": [
                "As of 2014 ”mobile” has also been added as an alternative (this is because it is now possible  to use a mobile phone to watch tv/films)."
              ],
              "K020": [
                "As of 2014 ”mobile” has also been added as an alternative (this is because it is now possible  to use a mobile phone to play games)."
              ],
              "K030": [
                "As of 2013 the indicator  On the Internet at least 3 hours per day  has been reformulated. Previously the question read  send e-mail, chat or surf on the net , which has been replaced with  on the Internet . However, when the answer alternatives are read, the terms e-mail, chat and surf are still used.",
                "Before 2014, one of the answer alternatives was ”I so not usually send e-mails, chat or surf on weekdays”. As of 2014 the text “e-mail, chat or surf” has been replaces by “be on internet”."
              ],
              "K040": [
                "Before 2014, one of the answer alternatives was ”I so not usually send e-mails, chat or surf on weekdays”. As of 2014 the text “e-mail, chat or surf” has been replaces by “be on internet”.",
                "As of 2013 the indicator  On the Internet at least 1 hour per day  has been reformulated. Previously the question read  send e-mail, chat or surf on the net , which has been replaced with  on the Internet . However, when the answer alternatives are read, the terms e-mail, chat and surf are still used."
              ]
            }
