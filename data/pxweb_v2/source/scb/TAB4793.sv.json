      "label": "Tabell 2.19 - Sysselsatta efter ålder och överenskommen arbetstid.  År 2021-2025",
      "source": "SCB",
      "updated": "2026-03-26T07:00:00Z",
      "link": {
        "related": [
          {
            "extension": {
              "relation": "statistics-homepage",
              "metaid": "PRODUCTCODE:LE0201"
            },
            "href": "https://www.scb.se/LE0201",
