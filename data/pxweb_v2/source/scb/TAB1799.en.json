            },
            "label": {
              "AA0003H1": "Proportion of persons living in their own home, percent",
              "AA0003H2": "Proportion of persons living in rented accommodation, percent",
              "AA0003H3": "Proportion of persons living in tenant-owned homes, percent",
              "AA0003H4": "Proportion of adult children living at home, percent",
              "AA0003H5": "Proportion of persons still living at home, percent"
            },
            "note": {
              "AA0003H1": [
                "The numerator consists of persons who live in their own homes. People who live in their own homes is obtained through assessed unit and ownership category. The denominator consists of the population. \r\n  \r\nSource: [STATIV database](https://www.scb.se/STATIV)"
              ],
              "AA0003H2": [
                "The numerator consists of persons who live in rented accommodation. People who live in rented accommodation is obtained through assessed unit and ownership category. The denominator consists of the population. \r\n  \r\nSource: [STATIV database](https://www.scb.se/STATIV)"
              ],
              "AA0003H3": [
                "The numerator consists of persons who live in tenant-owned homes. People who live in tenant-owned homes is obtained through assessed unit and ownership category. The denominator consists of the population. \r\n  \r\nSource: [STATIV database](https://www.scb.se/STATIV)"
              ],
              "AA0003H4": [
                "The numerator consists of persons aged 21–24 years who are recorded in the population register at the same property as at least one parent. The denominator consists of the population aged 21–24 years. The concept of family was not created until 1998, and for this reason data for 1997 is not presented. For persons born abroad, the link to a parent is largely absent if the person was older than 18 at the time of immigration. \r\n  \r\nSource: [Population statistics](https://scb.se/be0101-EN)"
              ],
              "AA0003H5": [
                "The numerator consists of persons recorded in the population register at 31/21 in year t-1 and who are still recorded in the population register in the region at 31/12 in year t. The denominator consists of the population at 31/12 in year t-1. \r\n  \r\nSource: [Population statistics](https://scb.se/be0101-EN)"
              ]
            },
