            "label": {
              "AM0104B4": "Average monthly salary in the central government sector",
              "AM0104B5": "Average basic salary in the central government sector",
              "AM0104B6": "Number of employees in the central government sector"
            },
            "note": {
              "AM0104B4": [
                "Monthly salary refer to the agreed salary including fixed allowances and variable pay as inconvenient-, on-call and emergency compensations. All salaries are recalculated into full time equivalents."
              ],
              "AM0104B5": [
                "Basic salary refers to contractually negotiated salary inlcuding fixed salary supplements. All such salaries are counted in total as full-time salaries."
              ],
              "AM0104B6": [
                "Refers to employees aged 18-64 for whom we can report salaries."
              ]
