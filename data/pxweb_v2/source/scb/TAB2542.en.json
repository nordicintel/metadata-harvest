      "label": "Life table by sex and age. Year 1960-2025",
      "source": "Statistics Sweden",
      "updated": "2026-03-24T07:00:00Z",
      "link": {
        "related": [
          {
            "extension": {
              "relation": "statistics-homepage",
              "metaid": "PRODUCTCODE:BE0101"
