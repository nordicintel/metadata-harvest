            "label": {
              "BMARK": "Grazing land",
              "FLYG": "Airports",
              "GBANA": "Golf courses",
              "KGARD": "Cemeteries",
              "KOLO": "Allotment gardens",
              "OGY": "Other green space",
              "TOTGY": "Total green space"
            },
            "note": {
              "BMARK": [
                "Land used for, or potentially can be conveniently used for, grazing and is not suitable for plowing. Grazing land is derived from the Land Parcel Information System (LPIS) managed by the Swedish Board of Agriculture."
              ],
              "FLYG": [
                "Land occupied by airports. It comprises runways, grass surfaces, storage areas and other facilities. The geographical delimitation of airport areas is based on the Cadastral map with additional processing by Statistics Sweden."
              ],
              "GBANA": [
                "Land occupied by golf courses. It comprises the golf course itself with greens, fairways, etc., and also the adjacent area as well as car parks. The geographical delimitation of golf courses is based on the Cadastral map with additional processing by Statistics Sweden."
              ],
              "KGARD": [
                "Land occupied by cemeteries. The geographical delimitation of cemeteries is based on the Cadastral map with additional processing by Statistics Sweden."
              ],
              "KOLO": [
                "Land occupied by allotment gardens. The geographical delimitation of allotment gardens is based on the Cadastral map with additional processing by Statistics Sweden."
              ],
              "OGY": [
                "Green space not included in land use categories grazing land, airports, golf courses, cemeteries or allotment gardens."
              ],
              "TOTGY": [
                "All types of vegetated patches that make up the total greenery within the urban boundary regardless of ownership or accessibility. Green space encompasses public parks as well as private villa gardens and green spaces between roads etc. Green space can be either open land or forested land."
              ]
            }
          },
