            "label": {
              "MI0603AL": "Totalareal tätort och omland, ha",
              "MI0603AJ": "Areal skyddad natur, ha",
              "MI0603AK": "Andel skyddad natur"
            },
            "note": {
              "MI0603AL": [
                "Omland är en zon på 3 km från tätortens yttre gräns. Arealen avser summan av tätortens och omlandets ytor. Redovisas i hektar."
              ],
              "MI0603AJ": [
                "Areal skyddad natur är skyddad areal inom tätorten och ett omland på 3 kilometer. Redovisas i hektar."
              ],
              "MI0603AK": [
                "Andel skyddad natur är Areal skyddad natur dividerat med Totalareal tätort och omland. Redovisas i procent."
              ]
