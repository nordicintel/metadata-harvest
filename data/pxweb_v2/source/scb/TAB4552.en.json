            "note": {
              "000000YE": [
                "Usual resident population in dwelling units connected to public water and waste water networks. A public network is typically operated by the municipality.  Dwelling units can be one-, two- or multi-dwelling units. Owners of multi-dwelling units are not obliged to submit information about water and waste water services to the Real Estate Assessment Register. However, it is assumed that all multi-dwelling units are connected to public networks."
              ],
              "000000YF": [
                "Usual resident population in dwelling units not connected to public water and waste water networks. Also population in dwelling units without water and wastewater connections is included."
              ]
