              "BO0501B4": "Purchase-price-coefficient"
            },
            "note": {
              "BO0501B3": [
                "For the yeas 1988–1993 the assessed value is according to the assessment of real estate in 1988. \r\n \nFor the yeas 1994–1999 the assessed value is according to the assessment of real estate in 1994. \r\n \nFor the yeas 2000–2003 the assessed value is according to the assessment of real estate in 2000. \r\n \nFor the yeas 2004–2006 the assessed value is according to the assessment of real estate in 2004. \r\n \nFor the yeas 2007–2009 the assessed value is according to the assessment of real estate in 2007. \r\n \nFor the yeas 2010–2012 the assessed value is according to the assessment of real estate in 2010. \r\n \nFor the yeas 2013–2015 the assessed value is according to the assessment of real estate in 2013. \r\n \nFor the yeas 2019–2021 the assessed value is according to the assessment of real estate in 2019. \r\n  From 2022 the assessed value is according to the assessment of real estate in 2022."
              ],
              "BO0501B4": [
                "Purchase-price-coefficient = Purchase price divided by assessed value",
                "For multi-dwelling and commercial buildings sold in 1988–1993 the purchase-price-coefficient is calculated as the purchase price according to the assessed value for 1988. \r\n  \r\nFor the years 1994–1999 the purchase-price-coefficient is calculated as the purchase price according to the assessed value for 1994. \r\n \nFor the years 2000–2003 the purchase-price-coefficient is calculated as the purchase price according to the assessed value for 2000. \r\n \nFor the years 2004–2006 the purchase-price-coefficient is calculated as the purchase price according to the assessed value for 2004. \r\n \nFor the years 2007–2009 the purchase-price-coefficient is calculated as the purchase price according to the assessed value for 2007. \r\n \nFor the years 2010–2012 the purchase-price-coefficient is calculated as the purchase price according to the assessed value for 2010. \r\n \nFor the years 2013–2015 the purchase-price-coefficient is calculated as the purchase price according to the assessed value for 2013. \r\n \nFor the years 2016–2018 the purchase-price-coefficient is calculated as the purchase price according to the assessed value for 2016. \r\n \nFor the years 2019–2021 the purchase-price-coefficient is calculated as the purchase price according to the assessed value for 2019. \r\n  \r\nFor the years 2022–2024 the purchase-price-coefficient is calculated as the purchase price according to the assessed value for 2022.  \r\n  \r\nFrom 2025 the purchase-price-coefficient is calculated as the purchase price according to the assessed value for 2025."
              ]
            },
