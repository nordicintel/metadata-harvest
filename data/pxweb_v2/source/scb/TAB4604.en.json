            "label": {
              "10": "purchased potable water ",
              "20": "purchased potable water and reused water",
              "30": "groundwater from own source",
              "40": "groundwater from own source including drainage water",
              "50": "surface water from own source",
              "60": "sea water from own source",
              "70": "water from unknown source",
              "80": "total volume of freshwater",
              "90": "total volume of water"
            },
            "note": {
              "10": [
                "Purchased potable water delivered from public or other water supplier."
              ],
              "20": [
                "Purchased potable water and treated or untreated water used by other economic unit before delivery."
              ],
              "30": [
                "Freshwater recovered, from an underground formation, by means of self-supply (excluding drainage water)."
              ],
              "40": [
                "Freshwater recovered from, an underground formation, by means of self-supply and drainage water from mines and quarries. Before 2015, drainage water was not included in the data collection. For time series analysis on groundwater abstraction, please use “Groundwater from own source”."
              ],
              "50": [
                "Freshwater recovered from lakes or other water courses by means of self-supply."
              ],
              "60": [
                "Sea water (salt or brackish water) recovered from the sea by means of self-supply. Sea water is surface water with a mass salinity higher than around 0,5 per mille."
              ],
              "70": [
                "Water with unknown source (ground water, surface water or sea water)."
              ],
              "80": [
                "Total volume of freshwater purchased and abstracted by means of self-supply. Freshwater is surface water and groundwater with a mass salinity less than around 0,5 per mille."
              ],
              "90": [
                "Total volume of freshwater and seawater purchased and abstracted by means of self-supply."
              ]
            }
