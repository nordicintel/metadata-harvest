              ],
              "2015K1": [
                "March 2015. In March 2015 the population increased by two institutions."
              ],
              "2018K4": [
                "October 2018. In October 2018 a banking company ceased to exist and a foreign bank branch in Sweden was added to the population."
              ],
              "2020K1": [
