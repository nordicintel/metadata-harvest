      "dimension": {
        "Innehall": {
          "label": "observations",
          "note": [
            "The Swedish premium pension authority (PPM) has been re-classified from the Social security sector to the Financial corporations sector. As of 1 January 2010 the Premium Pension Authority ceased to exist but holdings in the premium pension system are still included in the financial corporation sector.",
            "During the second quarter 2014 a number of foreign registered funds became Swedish registered. Roughly SEK 130 billion were moved."
          ],
          "category": {
            "index": {
              "inbet": 0,
              "utbet": 1,
              "netto": 2,
              "form": 3
            },
            "label": {
              "inbet": "gross savings in funds, sales",
              "utbet": "gross savings in funds, redemptions",
              "netto": "net savings in funds",
              "form": "market value of funds"
            },
            "note": {
              "inbet": [
                "Payments for sold fundshares. Reinvested dividends included."
              ],
              "utbet": [
                "Payment for redeemed fundshares."
              ],
              "netto": [
                "Sales less redemptions. Reinvested dividends included."
              ]
            }
