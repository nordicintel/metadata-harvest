      "label": "National parks and nature reserves, number by size class. Year 2018-2025",
      "source": "Statistics Sweden",
      "updated": "2026-05-29T06:00:00Z",
      "link": {
        "related": [
          {
            "extension": {
              "relation": "statistics-homepage",
              "metaid": "PRODUCTCODE:MI0603"
