            "label": {
              "OM": "Open land",
              "SKOG": "Forest",
              "TOTG": "Total green space",
              "TOTLA": "Total land area"
            },
            "note": {
              "OM": [
                "Defined as non-impervious surface that is not wooded, and neither consists of arable land. Open land represent a subset of the total green space. It includes lawns, open wetlands, scrubland and natural areas with sparse vegetation."
              ],
              "SKOG": [
                "Land with trees higher than 5 meters and a canopy cover of more than 10 percent, or trees able to reach these thresholds in situ."
              ],
              "TOTG": [
                "All types of vegetated patches that make up the total greenery within the urban boundary regardless of ownership or accessibility. Green space encompasses public parks as well as private villa gardens and green spaces between roads etc. Green space can be either open land or forested land."
              ],
              "TOTLA": [
                "Total land area within the urban boundary."
              ]
            }
