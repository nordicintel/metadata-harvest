            "note": {
              "2006K1": [
                "March 2006. March 2006. In March 2006 the population increased by one institute and at the same time the others increased their claims outside Sweden."
              ],
              "2009K1": [
                "March 2009. In March 2009 the population increased by three institutes."
              ],
              "2009K4": [
                "December 2009. In December 2009 the population increased by three institutes."
              ],
              "2012K1": [
                "March 2012. In March 2012 the population increased by one institute."
              ],
              "2013K4": [
                "December 2013.  From December 2013 and onwards, debt securities are calculated from Securities statistics."
              ],
              "2015K1": [
                "March 2015. In March 2015 the population increased by two institutions."
              ],
              "2018K4": [
                "October 2018. In October 2018 a banking company ceased to exist and a foreign bank branch in Sweden was added to the population."
              ],
              "2019K3": [
                "September: From September 2019 Monetary Financial Institutes’ securities are mainly based on data from Statistics Sweden’s survey Värdepappersinnehav (VINN) instead of Statistics Sweden’s survey Reporting of international claims and liabilities (RUTS)."
              ],
              "2020K1": [
                "March 2020. Great Britain is included in Other European countries as of March 2020. In previous periods, Great Britain was included in EU countries."
              ]
            }
