      "label": "Folkmängden efter region, civilstånd, ålder och kön. År 2025",
      "source": "SCB",
      "updated": "2026-02-24T07:00:00Z",
      "link": {
        "related": [
          {
            "extension": {
              "relation": "statistics-homepage",
              "metaid": "PRODUCTCODE:BE0101"
