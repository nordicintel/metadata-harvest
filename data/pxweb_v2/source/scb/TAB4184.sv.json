            "label": {
              "00000044": "Anställda tjänstemän, privat sektor (SLP)",
              "00000046": "Anställda tjänstemän, privat sektor (SLP), 95 procent konfidensintervall",
              "00000045": "Genomsnittlig ålder, tjänstemän privat sektor (SLP)",
              "0000004C": "Genomsnittlig månadslön, (tid o prestationslön), tjänstemän privat sektor (SLP), kronor",
              "00000048": "Genomsnittlig månadslön, (lön för arbetad tid), tjänstemän privat sektor (SLP), kronor",
              "0000004D": "Genomsnittlig månadslön (totallön), tjänstemän privat sektor (SLP), kronor",
              "00000047": "Genomsnittlig totallön, tjänstemän privat sektor (SLP), 95 procent konfidensintervall",
              "0000004B": "Totallön, tjänstemän privat sektor (SLP), undre kvartil",
