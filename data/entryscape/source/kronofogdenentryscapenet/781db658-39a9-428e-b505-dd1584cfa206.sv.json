      "catalogue": {
        "dataset_title": {
          "sv": "Väntetider hos Kronofogden"
        },
        "dataset_description": {
          "sv": "Väntetiden, tiden innan vi börjar arbeta med ett ärende och tiden det tar för oss att handlägga, är beroende av flera olika faktorer. Till exempel hur många ärenden vi får in, om ansökan behöver kompletteras, hur snabbt vi får kontakt med motparten eller om vi av någon anledning behöver registrera ett ärende manuellt.\n\nFör mer information, se dokumentation nedan."
        },
        "distribution_title": {
          "sv": "API - 2019 april till 2021 december"
        },
