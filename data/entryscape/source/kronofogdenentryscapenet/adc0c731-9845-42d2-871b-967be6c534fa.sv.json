      "catalogue": {
        "dataset_title": {
          "sv": "Så länge är skuldsatta kvar hos Kronofogden"
        },
        "dataset_description": {
          "sv": "Informationsmängden visar antalet privatpersoner som får sin första skuld lämnad till Kronofogden för indrivning samt hur många som finns kvar med skulder över tid.  \n\nInformationsmängden innehåller uppgifter om boende i län och kommun, kön, hur många som blev nya gäldenärer under ett år och hur många som är kvar vid varje årsskift."
        },
        "distribution_title": {
          "sv": "API"
        },
