      "catalogue": {
        "dataset_title": {
          "sv": "Utegym",
          "en": "Outdoor gym"
        },
        "dataset_description": {
          "sv": "Datamängden utegym (även kallat bland annat utomhusgym eller fitness station / outdoor gym på engelska) omfattar gym på allmän plats utomhus som är fri att användas för allmänheten, oftast året om och kostnadsfritt. Till utegym hör ofta enklare redskap och utrustning för styrketräning och konditionsträning. Datamängden innehåller information om t.ex. namn, plats, kontaktinformation med mera. Det kan även finnas kompletterande information om vilka redskap som finns.",
          "en": "The data set outdoor gym (outdoor gym or fitness station) includes gyms in public places outdoors that are free to use for the public, usually all year round and free of charge. Outdoor gyms often include simpler tools and equipment for strength training and cardio training. The data set contains information about e.g. name, location, contact information and more. There may also be additional information about which tools are available."
        },
        "distribution_title": {
          "sv": "Utegym-Södertälje API"
        },
        "source_distribution": "https://catalog.sodertalje.se/store/13/resource/14",
